# --- data & artifacts -------------------------------------------------------
# Leading slash matters: an unanchored `data/` would also exclude the
# src/somnoscope/data/ package, silently dropping the whole data pipeline from
# the repo.
/data/*
!/data/.gitkeep
/runs/
/checkpoints/
*.edf
*.EDF
*.npz
*.pt
*.pth
*.ckpt

# --- outputs ----------------------------------------------------------------
outputs/
figures/
*.png
!docs/*.png
*.csv
!tests/fixtures/*.csv

# --- python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
pip-wheel-metadata/

# --- environments -----------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- tooling ----------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- editors / os -----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
